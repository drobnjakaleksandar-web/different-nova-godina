# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "secret" ključ (sb_secret_...) ili stari "service_role" ključ. NIKAD ga ne delite i ne stavljajte u kod.
SUPABASE_SECRET_KEY=

# Zajednička šifra za ulaz u aplikaciju
APP_PIN=

# Dugačak nasumičan tekst (npr. 40+ znakova) za potpisivanje prijave
SESSION_SECRET=
